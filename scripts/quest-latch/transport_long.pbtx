buffers { size_kb: 131072 fill_policy: RING_BUFFER }
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      atrace_apps: "com.openipc.pixelpilot.xr"
      buffer_size_kb: 32768
      drain_period_ms: 250
    }
  }
}
# Stream the buffer into the output file every second, so a long run (e.g. 8 x 120 s ABBA, ~200 MB) never wraps the
# 128 MB ring and loses its start. link_audit.py's TRACE LOSS guard checks it.
write_into_file: true
file_write_period_ms: 1000
flush_period_ms: 5000
duration_ms: 120000
